strict digraph cycle {
    graph [layout = "fdp"; start = "7"; splines = "curved"; pad = "0.8,0.4"; outputorder = "edgesfirst";];
    graph [fontname = "Helvetica,Arial,sans-serif"; labelloc = "t";];
    node [fontname = "Helvetica,Arial,sans-serif"; style = "filled"; fillcolor = "white";];
    node [fontsize = 11; margin = "0.05,0.05";];
    edge [fontsize = 9; arrowsize = "0.6";];

    subgraph cluster_package {
        label="org.axonframework.messaging.core.annotation";
        style="filled";
        fillcolor="lightblue";
        "MethodInvokingMessageHandlingMember";
        "WrappedMessageHandlingMember";
        "AnnotatedMessageHandlingMemberDefinition";
        "MessageIdentifierParameterResolverFactory$MessageIdentifierParameterResolver";
        "MessageHandler";
        "DefaultParameterResolverFactory$MessageParameterResolver";
        "ChainedMessageHandlerInterceptorMember";
        "AggregateTypeParameterResolverFactory$AggregateTypeParameterResolver";
        "MessageHandlingMember";
        "DefaultParameterResolverFactory";
        "InterceptorChainParameterResolverFactory";
        "SourceIdParameterResolverFactory$SourceIdParameterResolver";
        "Message_pkg" [label="Message"];
        "MultiHandlerDefinition";
        "AnnotatedHandlerInspector";
        "HandlerAttributes";
        "HandlerDefinition";
        "MessageStreamResolverUtils";
        "PayloadParameterResolver";
        "AnnotatedHandlerAttributes";
        "DefaultParameterResolverFactory$MetadataParameterResolver";
        "DefaultParameterResolverFactory$AnnotatedMetadataParameterResolver";
        "AnnotationMessageTypeResolver";
    }

    subgraph cluster_dependent {
        label="org.axonframework.messaging.core";
        style="filled";
        fillcolor="peachpuff";
        "LegacyResources";
        "MessageHandlerInterceptorChain";
        "Context$ResourceKey";
        "ClassBasedMessageTypeResolver";
        "GenericMessage";
        "MessageStream$Entry";
        "DelayedMessageStream";
        "Metadata";
        "MessageStream";
        "MessageTypeResolver";
        "QualifiedName";
        "SimpleHandlerAttributes";
        "FluxUtils";
        "Message_dep" [label="Message"];
        "MonoUtils";
        "MessageStream$Empty";
        "MessageStream$Single";
        "MessageType";
    }

    "ChainedMessageHandlerInterceptorMember" -> "MessageStream" [color="#6699CC"; penwidth="0.5"];
    "MessageStreamResolverUtils" -> "MessageStream$Empty" [color="#6699CC"; penwidth="0.5"];
    "MessageStreamResolverUtils" -> "FluxUtils" [color="#6699CC"; penwidth="0.5"];
    "AnnotationMessageTypeResolver" -> "MessageTypeResolver" [color="#6699CC"; penwidth="0.5"];
    "AnnotatedHandlerInspector" -> "MessageStream" [color="#6699CC"; penwidth="0.5"];
    "MessageStreamResolverUtils" -> "GenericMessage" [color="#6699CC"; penwidth="0.5"];
    "InterceptorChainParameterResolverFactory" -> "Message_dep" [color="#6699CC"; penwidth="0.5"];
    "InterceptorChainParameterResolverFactory" -> "Context$ResourceKey" [color="#6699CC"; penwidth="0.5"];
    "AnnotationMessageTypeResolver" -> "MessageType" [color="#6699CC"; penwidth="0.5"];
    "MethodInvokingMessageHandlingMember" -> "MessageStream" [color="#6699CC"; penwidth="0.5"];
    "SourceIdParameterResolverFactory$SourceIdParameterResolver" -> "LegacyResources" [color="#6699CC"; penwidth="0.5"];
    "DefaultParameterResolverFactory$MetadataParameterResolver" -> "Message_dep" [color="#6699CC"; penwidth="0.5"];
    "WrappedMessageHandlingMember" -> "Message_dep" [color="#6699CC"; penwidth="0.5"];
    "DefaultParameterResolverFactory$AnnotatedMetadataParameterResolver" -> "Metadata" [color="#6699CC"; penwidth="0.5"];
    "SourceIdParameterResolverFactory$SourceIdParameterResolver" -> "Context$ResourceKey" [color="#6699CC"; penwidth="0.5"];
    "ChainedMessageHandlerInterceptorMember" -> "Message_dep" [color="#6699CC"; penwidth="0.5"];
    "MessageIdentifierParameterResolverFactory$MessageIdentifierParameterResolver" -> "Message_dep" [color="#6699CC"; penwidth="0.5"];
    "InterceptorChainParameterResolverFactory" -> "MessageStream" [color="#6699CC"; penwidth="0.5"];
    "Message_pkg" -> "Message_dep" [color="#6699CC"; penwidth="0.5"];
    "WrappedMessageHandlingMember" -> "MessageStream" [color="#6699CC"; penwidth="0.5"];
    "AnnotationMessageTypeResolver" -> "QualifiedName" [color="#6699CC"; penwidth="0.5"];
    "AnnotatedHandlerInspector" -> "Message_dep" [color="#6699CC"; penwidth="0.5"];
    "DefaultParameterResolverFactory$AnnotatedMetadataParameterResolver" -> "Message_dep" [color="#6699CC"; penwidth="0.5"];
    "MethodInvokingMessageHandlingMember" -> "MessageStream$Entry" [color="#6699CC"; penwidth="0.5"];
    "DefaultParameterResolverFactory" -> "Metadata" [color="#6699CC"; penwidth="0.5"];
    "DefaultParameterResolverFactory" -> "Message_dep" [color="#6699CC"; penwidth="0.5"];
    "MessageStreamResolverUtils" -> "MessageStream" [color="#6699CC"; penwidth="0.5"];
    "DefaultParameterResolverFactory$MetadataParameterResolver" -> "Metadata" [color="#6699CC"; penwidth="0.5"];
    "HandlerDefinition" -> "MessageStream" [color="#6699CC"; penwidth="0.5"];
    "AggregateTypeParameterResolverFactory$AggregateTypeParameterResolver" -> "LegacyResources" [color="#6699CC"; penwidth="0.5"];
    "MessageStreamResolverUtils" -> "MessageStream$Single" [color="#6699CC"; penwidth="0.5"];
    "MessageStreamResolverUtils" -> "MessageTypeResolver" [color="#6699CC"; penwidth="0.5"];
    "AnnotatedHandlerAttributes" -> "SimpleHandlerAttributes" [color="#6699CC"; penwidth="0.5"];
    "MethodInvokingMessageHandlingMember" -> "DelayedMessageStream" [color="#6699CC"; penwidth="0.5"];
    "MessageStreamResolverUtils" -> "MonoUtils" [color="#6699CC"; penwidth="0.5"];
    "MessageHandlingMember" -> "MessageStream" [color="#6699CC"; penwidth="0.5"];
    "AnnotationMessageTypeResolver" -> "ClassBasedMessageTypeResolver" [color="#6699CC"; penwidth="0.5"];
    "MethodInvokingMessageHandlingMember" -> "MessageStream$Empty" [color="#6699CC"; penwidth="0.5"];
    "AnnotatedMessageHandlingMemberDefinition" -> "MessageStream" [color="#6699CC"; penwidth="0.5"];
    "MethodInvokingMessageHandlingMember" -> "Message_dep" [color="#6699CC"; penwidth="0.5"];
    "InterceptorChainParameterResolverFactory" -> "MessageHandlerInterceptorChain" [color="#6699CC"; penwidth="0.5"];
    "MultiHandlerDefinition" -> "MessageStream" [color="#6699CC"; penwidth="0.5"];
    "MessageHandler" -> "Message_dep" [color="#6699CC"; penwidth="0.5"];
    "AnnotatedMessageHandlingMemberDefinition" -> "Message_dep" [color="#6699CC"; penwidth="0.5"];
    "MessageHandlingMember" -> "Message_dep" [color="#6699CC"; penwidth="0.5"];
    "AggregateTypeParameterResolverFactory$AggregateTypeParameterResolver" -> "Context$ResourceKey" [color="#6699CC"; penwidth="0.5"];
    "DefaultParameterResolverFactory$MessageParameterResolver" -> "Message_dep" [color="#6699CC"; penwidth="0.5"];
    "PayloadParameterResolver" -> "Message_dep" [color="#6699CC"; penwidth="0.5"];
    "MethodInvokingMessageHandlingMember" -> "MessageStream$Single" [color="#6699CC"; penwidth="0.5"];
    "SimpleHandlerAttributes" -> "HandlerAttributes" [color="red"; penwidth="2.5"; style="dashed";];
}
