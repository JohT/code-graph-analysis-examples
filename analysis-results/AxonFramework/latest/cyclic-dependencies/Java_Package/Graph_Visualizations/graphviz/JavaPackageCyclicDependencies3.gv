strict digraph cycle {
    graph [layout = "fdp"; start = "7"; splines = "curved"; pad = "0.8,0.4"; outputorder = "edgesfirst";];
    graph [fontname = "Helvetica,Arial,sans-serif"; labelloc = "t";];
    node [fontname = "Helvetica,Arial,sans-serif"; style = "filled"; fillcolor = "white";];
    node [fontsize = 11; margin = "0.05,0.05";];
    edge [fontsize = 9; arrowsize = "0.6";];

    subgraph cluster_package {
        label="org.axonframework.messaging.eventhandling.annotation";
        style="filled";
        fillcolor="lightblue";
        "MethodEventHandlerDefinition";
        "Event";
        "TimestampParameterResolverFactory";
        "MethodSequencingPolicyEventHandlerDefinition$SequencingPolicyEventMessageHandlingMember";
        "SequenceNumberParameterResolverFactory";
        "EventAppenderParameterResolverFactoryConfigurationEnhancer";
        "TimestampParameterResolverFactory$TimestampParameterResolver";
        "SequenceNumberParameterResolverFactory$SequenceNumberParameterResolver";
        "EventHandler";
        "EventAppenderParameterResolverFactory$1";
        "MethodSequencingPolicyEventHandlerDefinition";
        "EventAppenderParameterResolverFactory";
        "EventHandlingMember";
        "AnnotatedEventHandlingComponent";
        "MethodEventHandlerDefinition$MethodEventMessageHandlingMember";
    }

    subgraph cluster_dependent {
        label="org.axonframework.messaging.core.annotation";
        style="filled";
        fillcolor="peachpuff";
        "WrappedMessageHandlingMember";
        "HandlerTypeResolver";
        "MessageHandler";
        "AbstractAnnotatedParameterResolverFactory";
        "ParameterResolver";
        "MessageHandlingMember";
        "ParameterResolverFactory";
        "Message";
        "AnnotatedHandlerInspector";
        "HandlerDefinition";
        "UnsupportedHandlerException";
        "HandlerEnhancerDefinition";
        "SequencingPolicy";
    }

    "EventAppenderParameterResolverFactory" -> "ParameterResolver" [color="#6699CC"; penwidth="0.5"];
    "AnnotatedEventHandlingComponent" -> "MessageHandlingMember" [color="#6699CC"; penwidth="0.5"];
    "MethodSequencingPolicyEventHandlerDefinition" -> "MessageHandlingMember" [color="#6699CC"; penwidth="0.5"];
    "MethodSequencingPolicyEventHandlerDefinition" -> "HandlerEnhancerDefinition" [color="#6699CC"; penwidth="0.5"];
    "MethodEventHandlerDefinition" -> "HandlerEnhancerDefinition" [color="#6699CC"; penwidth="0.5"];
    "AnnotatedEventHandlingComponent" -> "ParameterResolverFactory" [color="#6699CC"; penwidth="0.5"];
    "TimestampParameterResolverFactory$TimestampParameterResolver" -> "ParameterResolver" [color="#6699CC"; penwidth="0.5"];
    "AnnotatedEventHandlingComponent" -> "HandlerDefinition" [color="#6699CC"; penwidth="0.5"];
    "EventHandlingMember" -> "MessageHandlingMember" [color="#6699CC"; penwidth="0.5"];
    "SequenceNumberParameterResolverFactory$SequenceNumberParameterResolver" -> "ParameterResolver" [color="#6699CC"; penwidth="0.5"];
    "MethodSequencingPolicyEventHandlerDefinition$SequencingPolicyEventMessageHandlingMember" -> "UnsupportedHandlerException" [color="#6699CC"; penwidth="0.5"];
    "MethodSequencingPolicyEventHandlerDefinition$SequencingPolicyEventMessageHandlingMember" -> "WrappedMessageHandlingMember" [color="#6699CC"; penwidth="0.5"];
    "EventHandler" -> "MessageHandler" [color="#6699CC"; penwidth="0.5"];
    "SequenceNumberParameterResolverFactory" -> "ParameterResolver" [color="#6699CC"; penwidth="0.5"];
    "Event" -> "Message" [color="#6699CC"; penwidth="0.5"];
    "AnnotatedEventHandlingComponent" -> "AnnotatedHandlerInspector" [color="#6699CC"; penwidth="0.5"];
    "EventAppenderParameterResolverFactory" -> "ParameterResolverFactory" [color="#6699CC"; penwidth="0.5"];
    "MethodSequencingPolicyEventHandlerDefinition" -> "SequencingPolicy" [color="#6699CC"; penwidth="0.5"];
    "EventAppenderParameterResolverFactoryConfigurationEnhancer" -> "ParameterResolverFactory" [color="#6699CC"; penwidth="0.5"];
    "SequenceNumberParameterResolverFactory" -> "AbstractAnnotatedParameterResolverFactory" [color="#6699CC"; penwidth="0.5"];
    "MethodEventHandlerDefinition$MethodEventMessageHandlingMember" -> "WrappedMessageHandlingMember" [color="#6699CC"; penwidth="0.5"];
    "MethodSequencingPolicyEventHandlerDefinition$SequencingPolicyEventMessageHandlingMember" -> "MessageHandlingMember" [color="#6699CC"; penwidth="0.5"];
    "EventAppenderParameterResolverFactory$1" -> "ParameterResolver" [color="#6699CC"; penwidth="0.5"];
    "TimestampParameterResolverFactory" -> "ParameterResolver" [color="#6699CC"; penwidth="0.5"];
    "MethodEventHandlerDefinition$MethodEventMessageHandlingMember" -> "UnsupportedHandlerException" [color="#6699CC"; penwidth="0.5"];
    "MethodEventHandlerDefinition" -> "MessageHandlingMember" [color="#6699CC"; penwidth="0.5"];
    "TimestampParameterResolverFactory" -> "AbstractAnnotatedParameterResolverFactory" [color="#6699CC"; penwidth="0.5"];
    "MethodEventHandlerDefinition$MethodEventMessageHandlingMember" -> "MessageHandlingMember" [color="#6699CC"; penwidth="0.5"];
    "HandlerTypeResolver" -> "EventHandler" [color="red"; penwidth="2.5"; style="dashed";];
}
