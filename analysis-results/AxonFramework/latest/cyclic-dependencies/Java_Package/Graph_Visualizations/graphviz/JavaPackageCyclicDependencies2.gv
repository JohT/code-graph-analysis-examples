strict digraph cycle {
    graph [layout = "fdp"; start = "7"; splines = "curved"; pad = "0.8,0.4"; outputorder = "edgesfirst";];
    graph [fontname = "Helvetica,Arial,sans-serif"; labelloc = "t";];
    node [fontname = "Helvetica,Arial,sans-serif"; style = "filled"; fillcolor = "white";];
    node [fontsize = 11; margin = "0.05,0.05";];
    edge [fontsize = 9; arrowsize = "0.6";];

    subgraph cluster_package {
        label="org.axonframework.messaging.eventhandling";
        style="filled";
        fillcolor="lightblue";
        "InterceptingEventSink";
        "GenericEventMessage";
        "EventHandlerRegistry";
        "SimpleEventBus";
        "EventHandlingComponent";
        "DelegatingEventHandlingComponent";
        "EventMessage";
        "EventHandler";
        "InterceptingEventBus";
        "InterceptingEventSink$InterceptingPublisher";
        "SimpleEventHandlingComponent";
        "EventBus";
        "NoHandlerForEventException";
    }

    subgraph cluster_dependent {
        label="org.axonframework.messaging.core";
        style="filled";
        fillcolor="peachpuff";
        "MessageHandler";
        "Context$ResourceKey";
        "MessageStream$Entry";
        "GenericMessage";
        "Metadata";
        "MessageStream";
        "QualifiedName";
        "DefaultMessageDispatchInterceptorChain";
        "Message";
        "MessageDecorator";
        "MessageStream$Empty";
        "MessageType";
        "MessageDispatchInterceptor";
        "SubscribableEventSource";
    }

    "EventMessage" -> "Message" [color="#6699CC"; penwidth="0.5"];
    "SimpleEventHandlingComponent" -> "QualifiedName" [color="#6699CC"; penwidth="0.5"];
    "SimpleEventHandlingComponent" -> "MessageStream" [color="#6699CC"; penwidth="0.5"];
    "SimpleEventHandlingComponent" -> "Message" [color="#6699CC"; penwidth="0.5"];
    "EventHandler" -> "MessageStream$Empty" [color="#6699CC"; penwidth="0.5"];
    "SimpleEventBus" -> "Context$ResourceKey" [color="#6699CC"; penwidth="0.5"];
    "DelegatingEventHandlingComponent" -> "Message" [color="#6699CC"; penwidth="0.5"];
    "SimpleEventHandlingComponent" -> "MessageType" [color="#6699CC"; penwidth="0.5"];
    "InterceptingEventBus" -> "MessageDispatchInterceptor" [color="#6699CC"; penwidth="0.5"];
    "EventHandlingComponent" -> "QualifiedName" [color="#6699CC"; penwidth="0.5"];
    "EventHandlingComponent" -> "MessageStream" [color="#6699CC"; penwidth="0.5"];
    "GenericEventMessage" -> "MessageType" [color="#6699CC"; penwidth="0.5"];
    "GenericEventMessage" -> "Message" [color="#6699CC"; penwidth="0.5"];
    "EventHandlingComponent" -> "MessageStream$Empty" [color="#6699CC"; penwidth="0.5"];
    "InterceptingEventSink$InterceptingPublisher" -> "MessageStream$Empty" [color="#6699CC"; penwidth="0.5"];
    "EventHandlerRegistry" -> "QualifiedName" [color="#6699CC"; penwidth="0.5"];
    "EventHandler" -> "MessageHandler" [color="#6699CC"; penwidth="0.5"];
    "InterceptingEventSink$InterceptingPublisher" -> "DefaultMessageDispatchInterceptorChain" [color="#6699CC"; penwidth="0.5"];
    "DelegatingEventHandlingComponent" -> "QualifiedName" [color="#6699CC"; penwidth="0.5"];
    "NoHandlerForEventException" -> "QualifiedName" [color="#6699CC"; penwidth="0.5"];
    "EventBus" -> "SubscribableEventSource" [color="#6699CC"; penwidth="0.5"];
    "DelegatingEventHandlingComponent" -> "MessageStream$Empty" [color="#6699CC"; penwidth="0.5"];
    "SimpleEventHandlingComponent" -> "MessageStream$Empty" [color="#6699CC"; penwidth="0.5"];
    "EventHandler" -> "Message" [color="#6699CC"; penwidth="0.5"];
    "GenericEventMessage" -> "MessageDecorator" [color="#6699CC"; penwidth="0.5"];
    "GenericEventMessage" -> "GenericMessage" [color="#6699CC"; penwidth="0.5"];
    "InterceptingEventSink" -> "MessageDispatchInterceptor" [color="#6699CC"; penwidth="0.5"];
    "InterceptingEventSink$InterceptingPublisher" -> "MessageStream" [color="#6699CC"; penwidth="0.5"];
    "EventHandlingComponent" -> "Message" [color="#6699CC"; penwidth="0.5"];
    "InterceptingEventSink$InterceptingPublisher" -> "MessageStream$Entry" [color="#6699CC"; penwidth="0.5"];
    "GenericEventMessage" -> "Metadata" [color="#6699CC"; penwidth="0.5"];
    "SubscribableEventSource" -> "EventMessage" [color="red"; penwidth="2.5"; style="dashed";];
}
