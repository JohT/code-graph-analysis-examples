strict digraph cycle {
    graph [layout = "fdp"; start = "7"; splines = "curved"; pad = "0.8,0.4"; outputorder = "edgesfirst";];
    graph [fontname = "Helvetica,Arial,sans-serif"; labelloc = "t";];
    node [fontname = "Helvetica,Arial,sans-serif"; style = "filled"; fillcolor = "white";];
    node [fontsize = 11; margin = "0.05,0.05";];
    edge [fontsize = 9; arrowsize = "0.6";];

    subgraph cluster_package {
        label="./lib/dom/ssr/fog-of-war.ts";
        style="filled";
        fillcolor="lightblue";
        "fetchAndApplyManifestPatches";
        "getPartialManifest";
        "useFogOFWarDiscovery_pkg" [label="useFogOFWarDiscovery"];
        "getPatchRoutesOnNavigationFunction_pkg" [label="getPatchRoutesOnNavigationFunction"];
        "isFogOfWarEnabled";
    }

    subgraph cluster_dependent {
        label="./index.ts";
        style="filled";
        fillcolor="peachpuff";
        "RouterState";
        "AssetsManifest";
        "PatchRoutesOnNavigationFunction";
        "DataRouteObject";
        "useFogOFWarDiscovery_dep" [label="useFogOFWarDiscovery"];
        "getPatchRoutesOnNavigationFunction_dep" [label="getPatchRoutesOnNavigationFunction"];
        "RouteModules";
        "Router";
        "RouteMatch";
        "createClientRoutes";
        "createPath";
    }

    "fetchAndApplyManifestPatches" -> "Router" [color="#6699CC"; penwidth="0.5"];
    "getPatchRoutesOnNavigationFunction_pkg" -> "Router" [color="#6699CC"; penwidth="0.5"];
    "fetchAndApplyManifestPatches" -> "AssetsManifest" [color="#6699CC"; penwidth="0.5"];
    "getPatchRoutesOnNavigationFunction_pkg" -> "AssetsManifest" [color="#6699CC"; penwidth="0.5"];
    "getPatchRoutesOnNavigationFunction_pkg" -> "RouteModules" [color="#6699CC"; penwidth="0.5"];
    "fetchAndApplyManifestPatches" -> "createClientRoutes" [color="#6699CC"; penwidth="0.5"];
    "fetchAndApplyManifestPatches" -> "RouteModules" [color="#6699CC"; penwidth="0.5"];
    "getPartialManifest" -> "Router" [color="#6699CC"; penwidth="0.5"];
    "getPartialManifest" -> "RouterState" [color="#6699CC"; penwidth="0.5"];
    "getPatchRoutesOnNavigationFunction_pkg" -> "RouterState" [color="#6699CC"; penwidth="0.5"];
    "useFogOFWarDiscovery_pkg" -> "RouteModules" [color="#6699CC"; penwidth="0.5"];
    "getPartialManifest" -> "AssetsManifest" [color="#6699CC"; penwidth="0.5"];
    "getPatchRoutesOnNavigationFunction_pkg" -> "createPath" [color="#6699CC"; penwidth="0.5"];
    "getPatchRoutesOnNavigationFunction_pkg" -> "PatchRoutesOnNavigationFunction" [color="#6699CC"; penwidth="0.5"];
    "getPartialManifest" -> "RouteMatch" [color="#6699CC"; penwidth="0.5"];
    "useFogOFWarDiscovery_pkg" -> "AssetsManifest" [color="#6699CC"; penwidth="0.5"];
    "useFogOFWarDiscovery_pkg" -> "Router" [color="#6699CC"; penwidth="0.5"];
    "getPartialManifest" -> "DataRouteObject" [color="#6699CC"; penwidth="0.5"];
    "getPatchRoutesOnNavigationFunction_dep" -> "isFogOfWarEnabled" [color="red"; penwidth="2.5"; style="dashed";];
    "useFogOFWarDiscovery_dep" -> "fetchAndApplyManifestPatches" [color="red"; penwidth="2.5"; style="dashed";];
    "useFogOFWarDiscovery_dep" -> "isFogOfWarEnabled" [color="red"; penwidth="2.5"; style="dashed";];
    "getPatchRoutesOnNavigationFunction_dep" -> "fetchAndApplyManifestPatches" [color="red"; penwidth="2.5"; style="dashed";];
}
